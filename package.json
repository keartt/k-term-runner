{
  "name": "k-term-runner",
  "productName": "k-term-runner",
  "version": "1.0.0",
  "description": "java -jar 같은 명령/터미널을 여러 개 띄워두고 로그를 쌓고 검색 + 포트 관리 + 로그 파일 뷰어",
  "main": "main.js",
  "scripts": {
    "start": "electron-forge start",
    "test": "node --test ports.test.js",
    "icons": "electron assets/make-icons.js",
    "package": "electron-forge package",
    "make:mac": "electron-forge make --platform=darwin",
    "make:win": "electron-forge make --platform=win32 --arch=x64"
  },
  "author": "shkang",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "electron": "^41.7.1"
  }
}
